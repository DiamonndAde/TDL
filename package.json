{
  "name": "tdl-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "analyze": "cross-env ANALYZE=true next build",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/verify.sh 1",
    "verify": "bash scripts/verify.sh 2",
    "verify:full": "bash scripts/verify.sh 3",
    "first-load": "node scripts/first-load.mjs",
    "test:scroll": "bash scripts/serve-and-run.sh python scripts/scroll-proof.py",
    "test:form": "bash scripts/serve-and-run.sh python scripts/form-proof.py docs/screenshots",
    "test:harden": "bash scripts/serve-and-run.sh python scripts/harden.py docs/screenshots",
    "test:android": "bash scripts/serve-and-run.sh python scripts/android-probe.py",
    "check:adapter": "node scripts/check-adapter.mjs",
    "test:provider": "node --experimental-strip-types --no-warnings scripts/provider-proof.mjs",
    "test:consent": "bash scripts/serve-and-run.sh python scripts/consent-proof.py docs/screenshots",
    "test:masking": "bash scripts/serve-and-run.sh python scripts/masking-proof.py",
    "test:guard": "bash scripts/placeholder-guard-proof.sh",
    "posthog:setup": "node scripts/posthog-setup.mjs",
    "posthog:seed": "node scripts/posthog-seed.mjs",
    "test:posthog-scripts": "node scripts/posthog-scripts-proof.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "posthog-js": "^1.434.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
