# Where /become-a-client submissions are delivered: any endpoint that accepts a JSON POST (inbox integration,
# CRM, automation). Unset in production, the form tells the visitor to use WhatsApp or the phone instead.
# CLIENT-QUESTIONS.md Q20.
FORM_WEBHOOK_URL=

# Client presentations only: fill the reserved photo frames with labelled, licensed stock (PLACEHOLDERS.md).
# Default false. Production builds refuse "true"; a local presentation build also needs
# PLACEHOLDER_PRESENTATION_BUILD=1. Named-person frames (testimonial portraits, leadership, board) stay empty regardless.
PLACEHOLDER_IMAGES=false

# Which recruitment adapter delivers the talent-pool form: zoho | webhook | none (src/lib/recruitment/).
# Unset it auto-selects: the ATS when its credentials are set, else the webhook, else none (which refuses
# honestly rather than dropping a submission). Set it only to force a provider.
RECRUITMENT_PROVIDER=

# The careers board /careers links to. Defaults to the URL in src/content/about.ts; set this to move the board
# without a content edit — the first thing a change of ATS would use.
RECRUITMENT_BOARD_URL=

# Talent-pool form (/careers) → Zoho Recruit, where TDL's recruiters work. A Self Client from api-console.zoho.com
# with scopes ZohoRecruit.modules.candidates.CREATE and ZohoRecruit.modules.notes.CREATE; the API is on every
# edition including Free. Unset, the form falls back to FORM_WEBHOOK_URL. CLIENT-QUESTIONS.md Q29.
ZOHO_RECRUIT_CLIENT_ID=
ZOHO_RECRUIT_CLIENT_SECRET=
ZOHO_RECRUIT_REFRESH_TOKEN=
# Only if the org is not on the US data centre (e.g. accounts.zoho.eu / recruit.zoho.eu).
# ZOHO_ACCOUNTS_HOST=accounts.zoho.com
# ZOHO_RECRUIT_API_HOST=recruit.zoho.com
# A value that exists in the org's Candidates → Source picklist, e.g. "Web Site". Omit to leave Zoho's default.
# ZOHO_RECRUIT_SOURCE=

# Client presentations only: leave out every reserved "Photograph to come" / "Portrait to come" frame, so a page
# reads as it will once TDL's photography arrives. Hides, never shows; still remove before launch.
PRESENTATION_HIDE_EMPTY_FRAMES=false

# ---------------------------------------------------------------------------------------------------------
# Analytics (docs/ANALYTICS-PROPOSAL.md). EVERYTHING here is off until a project key is set: no consent banner,
# no SDK download, no request. Do not set these until TDL approves Q30 and the privacy notice is updated.
# ---------------------------------------------------------------------------------------------------------
# PostHog project key. The master switch — unset means analytics does not exist on the site.
NEXT_PUBLIC_POSTHOG_KEY=

# EU cloud (Frankfurt) by default. PostHog fixes a project's region AT CREATION and it cannot be changed, so the
# project must be created in the EU cloud. Analytics data therefore leaves Nigeria; the privacy notice says so.
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Session replay is on /careers only. Set this to true to add /become-a-client, if TDL approves it (Q30d).
NEXT_PUBLIC_ANALYTICS_REPLAY_ENQUIRY=false

# Fraction of sessions on a replay route that are recorded. Default 0.05, sized so a viral job posting —
# 20,000 careers visitors in a week — uses 1,000 of the 5,000 free monthly recordings rather than all of them
# (docs/ANALYTICS-PROPOSAL.md §7). Raise to 0.25 for a deliberate investigation in a quiet month, then put it back.
# NEXT_PUBLIC_ANALYTICS_REPLAY_SAMPLE=0.05

# Prepared and OFF (proposal §9). The careers survey is defined in the PostHog project; this only lets the SDK
# load the surveys script. Leave unset until Q30(g) is answered.
NEXT_PUBLIC_ANALYTICS_SURVEYS=false

# Prepared and OFF (proposal §9). The careers call-to-action experiment. Unset, the button always reads "See
# current openings" and no flag is read. Leave unset until Q30(h) is answered.
NEXT_PUBLIC_ANALYTICS_EXPERIMENTS=false

# The query parameter TDL's ATS reads as the candidate's source, e.g. "source". Unset by default: whether Zoho
# writes it onto the candidate record is unconfirmed (Q29f), and a parameter that does nothing is noise.
# ZOHO_RECRUIT_SOURCE_PARAM=
